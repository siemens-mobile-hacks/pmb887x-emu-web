diff --git a/system/cpu-timers.c b/system/cpu-timers.c
index ec613e0a0f..b6493b91f9 100644
--- a/system/cpu-timers.c
+++ b/system/cpu-timers.c
@@ -71,13 +71,22 @@ int64_t cpu_get_ticks(void)
     return ticks;
 }
 
+/* BENCH ONLY: the vt clock's host reading runs 1000x wall speed */
+static int64_t cpu_clock_free_run_base = -1;
+
+void cpu_clock_set_free_run(int on)
+{
+    qatomic_store_release(&cpu_clock_free_run_base, on ? get_clock() : -1);
+}
+
 int64_t cpu_get_clock_locked(void)
 {
-    int64_t time;
+    int64_t time, base;
 
     time = timers_state.cpu_clock_offset;
     if (timers_state.cpu_ticks_enabled) {
-        time += get_clock();
+        base = qatomic_load_acquire(&cpu_clock_free_run_base);
+        time += base < 0 ? get_clock() : base + (get_clock() - base) * 1000;
     }
 
     return time;
