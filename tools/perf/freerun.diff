@@ -205,6 +205,13 @@ int32_t wasm_clock_banked(void)
     return cpu_clock_banked();
 }
 
+/* BENCH ONLY: guest never waits for real time */
+EMSCRIPTEN_KEEPALIVE
+void wasm_free_run(int32_t on)
+{
+    cpu_clock_set_free_run(on);
+}
