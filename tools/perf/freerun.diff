 /*
  * PMB887X-WEB FEATURE (deterministic clock): real time leaves the clock.
diff --git a/system/cpu-timers.c b/system/cpu-timers.c
index c5415dc3e3..2e55255a49 100644
--- a/system/cpu-timers.c
+++ b/system/cpu-timers.c
@@ -78,12 +78,23 @@ int64_t cpu_get_ticks(void)
 static bool cpu_clock_deterministic;
 static int64_t cpu_clock_deterministic_host;
 
+/* BENCH ONLY: the vt clock's host reading runs 1000x wall speed */
+static int64_t cpu_clock_free_run_base = -1;
+
+void cpu_clock_set_free_run(int on)
+{
+    qatomic_store_release(&cpu_clock_free_run_base, on ? get_clock() : -1);
+}
+
 static int64_t cpu_clock_host(void)
 {
+    int64_t base;
+
     if (cpu_clock_deterministic) {
         return qatomic_read(&cpu_clock_deterministic_host);
     }
-    return get_clock();
+    base = qatomic_load_acquire(&cpu_clock_free_run_base);
+    return base < 0 ? get_clock() : base + (get_clock() - base) * 1000;
 }
 
 int64_t cpu_get_clock_locked(void)
