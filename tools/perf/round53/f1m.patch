+/*
+ * The TLB memo.  A hit that another access of the same kind follows
+ * (W.memo_prod) leaves the entry's page, zero-extended, in $mkey and its
+ * addend in $madd; the miss arm sets $mkey to -1, which no zero-extended
+ * address matches.  The next access tests its address against $mkey
+ * instead of probing, as long as nothing between the two can have changed
+ * the TLB -- no call (W.epoch) -- and both arms of the first one reach it
+ * -- no label.  An entry that hit is clean for its whole page, so a second
+ * access inside that page, aligned as its own memop demands, may use the
+ * addend.  Two tests, both a single compare against the i64 key:
+ *   adj == 0:    ((addr ^ mkey) & (PAGE_MASK | a_mask)) == 0
+ *   a_mask == 0: (addr ^ mkey) < PAGE_SIZE - adj     (no page straddle)
+ * Hot TBs spill and refill the guest stack in ldm/stm/push/pop clusters,
+ * one page for the whole cluster.
+ */
+static bool w64_memo_test(TCGContext *s, const struct w64_tlb_ctx *tc)
+{
+    if (!W.cur_use || W.memo_epoch != W.epoch || W.memo_kind != tc->kind ||
+        (tc->adj && tc->a_mask)) {
+        return false;
+    }
+    w64_local_get(s, W64_L_SCR2);
+    w64_local_get(s, W64_L_MKEY);
+    w64_u8(s, 0x85);                        /* i64.xor */
+    if (tc->adj == 0) {
+        w64_const_i64(s, (int64_t)tc->tlb_mask);
+        w64_u8(s, 0x83);                    /* i64.and */
+        w64_u8(s, 0x50);                    /* i64.eqz */
+    } else {
+        w64_const_i64(s, TARGET_PAGE_SIZE - tc->adj);
+        w64_u8(s, 0x54);                    /* i64.lt_u */
+    }
     return true;
 }
 
+/* the hit arm of a producer: $mkey = the page (the hit proved it is the
+ * entry's), $madd was teed by w64_tlb_haddr */
+static void w64_memo_set(TCGContext *s)
+{
+    w64_local_get(s, W64_L_SCR2);
+    w64_const_i64(s, (int64_t)(int)TARGET_PAGE_MASK);
+    w64_u8(s, 0x83);                        /* i64.and */
+    w64_local_set(s, W64_L_MKEY);
+}
+
+/* the miss arm of a producer, ahead of the helper call: nothing of the
+ * old memo stays live across it */
+static void w64_memo_kill(TCGContext *s)
+{
+    w64_const_i64(s, -1);
+    w64_local_set(s, W64_L_MKEY);
+    w64_const_i32(s, 0);
+    w64_local_set(s, W64_L_MADD);
+}
+
+/* called once per qemu_ld/st, in op order, like the scan's ordinal */
+static bool w64_memo_prod(void)
+{
+    unsigned k = W.n_memop++;
+
+    W.cur_use = k < W64_MAX_MEMO && (W.memo_use[k / 64] >> (k % 64)) & 1;
+    return k < W64_MAX_MEMO && (W.memo_prod[k / 64] >> (k % 64)) & 1;
+}
+
+static void w64_memo_end(TCGContext *s, bool fast, bool memo, bool prod,
+                         const struct w64_tlb_ctx *tc)
+{
+    if (fast) {
+        w64_blk_pop(s);                     /* end (probe if/else) */
+    }
+    if (memo) {
+        w64_blk_pop(s);                     /* end (memo if/else) */
+    }
+    if (prod) {
+        W.memo_epoch = W.epoch;
+        W.memo_kind = tc->kind;
+    }
