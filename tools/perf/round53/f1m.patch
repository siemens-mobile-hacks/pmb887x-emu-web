+static void w64_base_def(TCGOp *op, unsigned nb_oargs)
+{
+    unsigned i;
+    int src = -1;
+
+    if (op->opc == INDEX_op_mov) {
+        src = 1;
+    } else if (op->opc == INDEX_op_add) {
+        if (arg_temp(op->args[2])->kind == TEMP_CONST) {
+            src = 1;
+        } else if (arg_temp(op->args[1])->kind == TEMP_CONST) {
+            src = 2;
+        }
+    }
+    for (i = 0; i < nb_oargs; i++) {
+        size_t d = temp_idx(arg_temp(op->args[i]));
+
+        if (src >= 0) {
+            size_t f = temp_idx(arg_temp(op->args[src]));
+            w64_broot[d] = w64_broot[f];
+            w64_bver[d] = w64_bver[f];
+        } else {
+            w64_broot[d] = d;
+            w64_bver[d] = ++w64_tver[d];
+        }
+    }
+}
