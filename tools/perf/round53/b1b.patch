diff --git a/include/tcg/tcg.h b/include/tcg/tcg.h
index ae4725fda6..cb0a594b47 100644
--- a/include/tcg/tcg.h
+++ b/include/tcg/tcg.h
@@ -416,7 +416,20 @@ struct TCGContext {
      */
     bool carry_live;
 
-    GHashTable *const_table[TCG_TYPE_COUNT];
+    /*
+     * Constant interning for the current TB (tcg_constant_internal): an
+     * open-addressed table whose entries are valid only while their stamp
+     * equals const_gen, so tcg_func_start clears it by bumping the stamp.
+     * A GHashTable here was cleared, shrunk to 8 buckets and regrown
+     * through several reallocations on every translation.
+     */
+    struct {
+        uint32_t gen;
+        uint8_t type;
+        int64_t val;
+        TCGTemp *ts;
+    } const_slots[256];
+    uint32_t const_gen;
     TCGTempSet free_temps[TCG_TYPE_COUNT];
     TCGTemp temps[TCG_MAX_TEMPS]; /* globals first, temps after */
 
diff --git a/tcg/tcg.c b/tcg/tcg.c
index 83df93fc34..d48d3e9707 100644
--- a/tcg/tcg.c
+++ b/tcg/tcg.c
@@ -1938,10 +1938,9 @@ void tcg_func_start(TCGContext *s)
     tcg_temp_ebb_reset_freed(s);
 
     /* No constant temps have been previously allocated. */
-    for (int i = 0; i < TCG_TYPE_COUNT; ++i) {
-        if (s->const_table[i]) {
-            g_hash_table_remove_all(s->const_table[i]);
-        }
+    if (unlikely(++s->const_gen == 0)) {
+        memset(s->const_slots, 0, sizeof(s->const_slots));
+        s->const_gen = 1;
     }
 
     s->nb_ops = 0;
@@ -2241,25 +2240,42 @@ void tcg_temp_free_vec(TCGv_vec arg)
 TCGTemp *tcg_constant_internal(TCGType type, int64_t val)
 {
     TCGContext *s = tcg_ctx;
-    GHashTable *h = s->const_table[type];
+    const unsigned n = ARRAY_SIZE(s->const_slots);
+    unsigned i = (unsigned)(((uint64_t)val * 0x9E3779B97F4A7C15ull) >> 56) ^ type;
+    unsigned probe;
+    int free_slot = -1;
     TCGTemp *ts;
 
-    if (h == NULL) {
-        h = g_hash_table_new(g_int64_hash, g_int64_equal);
-        s->const_table[type] = h;
+    /*
+     * Interning is a space saving, not a requirement: two temps holding
+     * the same constant are both correct.  So the probe is short, and a
+     * TB with more distinct constants than the table fits gets a fresh
+     * temp for the surplus.
+     */
+    for (probe = 0; probe < 8; probe++, i = (i + 1) & (n - 1)) {
+        if (s->const_slots[i].gen != s->const_gen) {
+            if (free_slot < 0) {
+                free_slot = i;
+            }
+            continue;
+        }
+        if (s->const_slots[i].type == type && s->const_slots[i].val == val) {
+            return s->const_slots[i].ts;
+        }
     }
 
-    ts = g_hash_table_lookup(h, &val);
-    if (ts == NULL) {
-        ts = tcg_temp_alloc(s);
-        ts->base_type = type;
-        ts->type = type;
-        ts->kind = TEMP_CONST;
-        ts->temp_allocated = 1;
-        ts->val = val;
-        g_hash_table_insert(h, &ts->val, ts);
+    ts = tcg_temp_alloc(s);
+    ts->base_type = type;
+    ts->type = type;
+    ts->kind = TEMP_CONST;
+    ts->temp_allocated = 1;
+    ts->val = val;
+    if (free_slot >= 0) {
+        s->const_slots[free_slot].gen = s->const_gen;
+        s->const_slots[free_slot].type = type;
+        s->const_slots[free_slot].val = val;
+        s->const_slots[free_slot].ts = ts;
     }
-
     return ts;
 }
 
