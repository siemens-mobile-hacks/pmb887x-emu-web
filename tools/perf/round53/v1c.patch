+/*
+ * The features whose absence makes every question rebuild_hflags_a32()
+ * asks answerable from two words of state (hflags.c
+ * rebuild_hflags_a32_fast): the exception level, SCTLR and CPSR.{E, IL,
+ * PAN}.  An ARMv5 A-profile core with an MMU - the pmb887x's ARM926EJ-S -
+ * has none of them.
+ */
+#define HFLAGS_A32_FAST_FEATURES                                        \
+    ((1ULL << ARM_FEATURE_M) | (1ULL << ARM_FEATURE_AARCH64) |          \
+     (1ULL << ARM_FEATURE_EL2) | (1ULL << ARM_FEATURE_EL3) |            \
+     (1ULL << ARM_FEATURE_PMSA) | (1ULL << ARM_FEATURE_V6))
+
+/*
+ * On such a core, does hflags change between two CPSR values?  The mode
+ * bits matter only as the exception level, USR against every other mode:
+ * SVC, SYS, IRQ, ABT, UND and FIQ all read sctlr_el[1] through the same
+ * mmu_idx, so an exception taken from EL1, and a mode-changing msr inside
+ * EL1, leave hflags where they were.
+ */
+static inline bool arm_a32_hflags_moved(uint32_t old_cpsr, uint32_t new_cpsr)
+{
+    uint32_t moved = old_cpsr ^ new_cpsr;
+
+    return (moved & (CPSR_E | CPSR_IL | CPSR_PAN)) ||
+           (((old_cpsr & CPSR_M) == ARM_CPU_MODE_USR) !=
+            ((new_cpsr & CPSR_M) == ARM_CPU_MODE_USR));
+}
+
 static inline uint32_t aarch32_cpsr_valid_mask(uint64_t features,
                                                const ARMISARegisters *id)
 {
