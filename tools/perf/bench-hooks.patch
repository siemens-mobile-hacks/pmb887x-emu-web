# Local measurement hooks the 2026-09-22 review removed from the port: the
# runtime real-time-cap switch videobench needs and eight census slots.
# Apply to BOTH arms of an A/B, never commit to qemu/:
#   git -C qemu apply ../tools/perf/bench-hooks.patch
diff --git a/accel/tcg/icount-common.c b/accel/tcg/icount-common.c
index feeaa34d4f..0206fa17aa 100644
--- a/accel/tcg/icount-common.c
+++ b/accel/tcg/icount-common.c
@@ -125,6 +125,16 @@ void icount_rtcap_set_waiting(bool waiting)
     qatomic_set(&rtcap_vcpu_waiting, waiting);
 }
 
+/* Bench hook (tools/perf/bench-hooks.patch): not part of the port. */
+void icount_rtcap_set_enabled(bool on)
+{
+    if (on) {
+        rtcap_v0 = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        rtcap_r0 = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    }
+    qatomic_set(&icount_rtcap, on);
+}
+
 /* Polled from the browser main thread while the vCPU thread writes it. */
 int icount_rtcap_mode(void)
 {
diff --git a/accel/tcg/tb-maint.c b/accel/tcg/tb-maint.c
index 03d3a4d52e..407961e385 100644
--- a/accel/tcg/tb-maint.c
+++ b/accel/tcg/tb-maint.c
@@ -1172,6 +1172,13 @@ static void do_tb_phys_invalidate(TranslationBlock *tb, bool rm_from_page_list)
     uint32_t orig_cflags = tb_cflags(tb);
 
     assert_memory_lock();
+#ifdef CONFIG_TCG_WASM64
+    {
+        /* bench census slot 7 (tools/perf/bench-hooks.patch) */
+        extern uint64_t wasm_bench_ctr[8];
+        wasm_bench_ctr[7]++;
+    }
+#endif
     qemu_thread_jit_write();
 
     /* make sure no further incoming jumps will be chained to this TB */
diff --git a/include/exec/icount.h b/include/exec/icount.h
index 61b0a9dea1..c11b85ca72 100644
--- a/include/exec/icount.h
+++ b/include/exec/icount.h
@@ -93,5 +93,6 @@ int64_t icount_rtcap_excess_ns(int64_t vtarget);
 void icount_rtcap_set_waiting(bool waiting);
 /* 0 = off, 1 = banked (the boot window), 3 = budget.  Safe from any thread. */
 int icount_rtcap_mode(void);
+void icount_rtcap_set_enabled(bool on);
 
 #endif /* EXEC_ICOUNT_H */
diff --git a/tcg/wasm64/wasm64.c b/tcg/wasm64/wasm64.c
index 4fe79a8aef..21d4fb0b00 100644
--- a/tcg/wasm64/wasm64.c
+++ b/tcg/wasm64/wasm64.c
@@ -20,6 +20,12 @@
 #include "wasm64.h"
 #include "w64-interp.h"
 
+/* Bench census slots (tools/perf/bench-hooks.patch): not part of the port.
+ * 0 translations, 1 modules instantiated, 2 evictions, 3 re-instantiations,
+ * 4 tb_flush, 5 live modules summed per translation (/slot 0 = mean live),
+ * 6 code-buffer bytes consumed, 7 TBs invalidated (tb-maint.c). */
+extern uint64_t wasm_bench_ctr[8];
+
 QEMU_BUILD_BUG_ON(W64_TCP_FIDX != W64_DESC_FIDX);
 QEMU_BUILD_BUG_ON(W64_TCP_TIDX != W64_DESC_TIDX);
 
@@ -438,6 +444,17 @@ static void w64_batch_close(void);
  */
 void w64_batch_begin_tb(void)
 {
+    {
+        static uintptr_t prev_cg;
+        uintptr_t cg = (uintptr_t)tcg_ctx->code_gen_ptr;
+
+        wasm_bench_ctr[0]++;
+        wasm_bench_ctr[5] += w64_live_n;
+        if (cg > prev_cg && cg - prev_cg < (1u << 20)) {
+            wasm_bench_ctr[6] += cg - prev_cg;
+        }
+        prev_cg = cg;
+    }
     if (B.id != 0 &&
         (B.n_uimp > W64_UMAX_IMPORTS - W64_MAX_IMPORTS - 1 ||
          B.n_utypes > W64_UMAX_TYPES - W64_MAX_TYPES - 1)) {
@@ -694,6 +711,7 @@ static uint32_t w64_assemble_instantiate(const struct w64_bsrc *src)
     uint32_t thunk;
     unsigned m, i;
     unsigned nfn = src->n_member + 1;   /* members, then the thunk */
+    wasm_bench_ctr[1]++;
     mb_put(&mod, magic, sizeof(magic));
 
     /* type section: union types + the thunk signature */
@@ -864,6 +882,7 @@ static void w64_batch_evict_oldest(void)
     if (!l) {
         return;
     }
+    wasm_bench_ctr[2]++;
     w64_live_head = l->next;
     if (!w64_live_head) {
         w64_live_tail = NULL;
@@ -946,6 +965,7 @@ static void w64_batch_ensure(uint32_t id)
     if (l->thunk) {
         return;
     }
+    wasm_bench_ctr[3]++;
     l->thunk = w64_assemble_instantiate(&l->src);
     w64_landed_flip(l);
     w64_live_push(l);
@@ -1095,6 +1115,7 @@ void w64_batch_flush(void)
 {
     struct w64_landed *l;
 
+    wasm_bench_ctr[4]++;
     w64_irec_flush();
     for (l = w64_live_head; l; l = l->next) {
         w64_remove((int)l->thunk);
diff --git a/ui/wasm.c b/ui/wasm.c
index 565cf13434..1c28fa5747 100644
--- a/ui/wasm.c
+++ b/ui/wasm.c
@@ -202,6 +202,22 @@ int32_t wasm_rtcap(void)
     return icount_rtcap_mode();
 }
 
+/* Bench hook (tools/perf/bench-hooks.patch): not part of the port. */
+EMSCRIPTEN_KEEPALIVE
+void wasm_rtcap_set(int32_t on)
+{
+    icount_rtcap_set_enabled(!!on);
+}
+
+/* Bench census slots: temporary increment sites add to these. */
+uint64_t wasm_bench_ctr[8];
+
+EMSCRIPTEN_KEEPALIVE
+uint64_t wasm_bench_ctr_get(int32_t i)
+{
+    return wasm_bench_ctr[i & 7];
+}
