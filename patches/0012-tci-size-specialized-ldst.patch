+/*
+ * Size-specialized guest memory ops: the generic qemu_ld/st interpreter
+ * cases recompute the TLB compare masks (s_mask/a_mask/atom) and dispatch
+ * on the size for every access.  For mops of the exact family
+ * MO_ALIGN|MO_ATOM_NONE|size(|sign) - which on pmb887x/ARMv5 is every
+ * plain guest data access - the generic probe tci_tlb_probe() reduces to
+ *     (addr & (TARGET_PAGE_MASK | size-1)) == tlb_addr
+ * (a_mask == s_mask, atom bits = NONE, LE host) so these variants bake that
+ * in: no mask math, no atom branch, no size switch, straight to the access
+ * on a hit.  The rrm immediate field carries only the mmu_idx; the case
+ * reconstructs the full MemOp (see TCI_SPEC_LD/ST in tcg/tci.c).
+ * The emitters (tgen_qemu_ld/st) pick them only on the exact family match;
+ * everything else keeps the generic path.
+ */
+DEF(tci_qemu_ld8, 1, 2, 0, TCG_OPF_NOT_PRESENT)
+DEF(tci_qemu_ld8s, 1, 2, 0, TCG_OPF_NOT_PRESENT)
+DEF(tci_qemu_ld16, 1, 2, 0, TCG_OPF_NOT_PRESENT)
+DEF(tci_qemu_ld16s, 1, 2, 0, TCG_OPF_NOT_PRESENT)
+DEF(tci_qemu_ld32, 1, 2, 0, TCG_OPF_NOT_PRESENT)
+DEF(tci_qemu_st8, 0, 3, 0, TCG_OPF_NOT_PRESENT)
+DEF(tci_qemu_st16, 0, 3, 0, TCG_OPF_NOT_PRESENT)
+DEF(tci_qemu_st32, 0, 3, 0, TCG_OPF_NOT_PRESENT)
diff --git a/tcg/tci/tcg-target.c.inc b/tcg/tci/tcg-target.c.inc
--- a/tcg/tci/tcg-target.c.inc	2026-09-08 19:29:11.805191738 +0000
+++ b/tcg/tci/tcg-target.c.inc	2026-09-08 19:06:04.073762339 +0000
@@ -1231,14 +1231,69 @@
     .out_r = tcg_out_st,
 };
 
+/*
+ * Does this mop reduce tci_tlb_probe() to the specialized compare
+ * (addr + size-1) & TARGET_PAGE_MASK == tlb_addr (see tci_probe_1)?
+ * Requires: no bswap, a_mask == 0 (no MO_ALIGN bits, MO_ALIGN_TLB_ONLY ok),
+ * and atomicity that never forces the helper path for a probe hit
+ * (IFALIGN - the default - and NONE; a plain aligned load/store satisfies
+ * IFALIGN, and misaligned accesses the specialized compare still admits
+ * have no atomicity requirement).
+ */
+static bool tci_mop_specializes(MemOp mop)
+{
+    if ((mop & ~(MO_SIZE | MO_SIGN)) != (MO_ALIGN | MO_ATOM_NONE)) {
+        return false;
+    }
+    if ((mop & MO_SIZE) > MO_32) {
+        return false;
+    }
+    return true;
+}
+
 static void tgen_qemu_ld(TCGContext *s, TCGType type, TCGReg data,
                          TCGReg addr, MemOpIdx oi)
 {
-    if (oi & ~0xffff) {
+    if (oi & ~0xffff && !tci_mop_specializes(get_memop(oi))) {
         tcg_out_movi(s, TCG_TYPE_I32, TCG_REG_TMP, oi);
         tcg_out_op_rrr(s, INDEX_op_tci_qemu_ld_rrr, data, addr, TCG_REG_TMP);
-    } else {
-        tcg_out_op_rrm(s, INDEX_op_qemu_ld, data, addr, oi);
+        return;
+    }
+    {
+        MemOp mop = get_memop(oi);
+        TCGOpcode op = INDEX_op_qemu_ld;
+
+        if (tci_mop_specializes(mop)) {
+            switch (mop & (MO_SIZE | MO_SIGN)) {
+            case MO_UB:
+                op = INDEX_op_tci_qemu_ld8;
+                break;
+            case MO_SB:
+                op = INDEX_op_tci_qemu_ld8s;
+                break;
+            case MO_UW:
+                op = INDEX_op_tci_qemu_ld16;
+                break;
+            case MO_SW:
+                op = INDEX_op_tci_qemu_ld16s;
+                break;
+            case MO_UL:
+                op = INDEX_op_tci_qemu_ld32;
+                break;
+            case MO_SL:
+                /* i64 + MO_SL sign-extends to 64 bits; i32 does not care. */
+                op = type == TCG_TYPE_I32
+                    ? INDEX_op_tci_qemu_ld32 : INDEX_op_qemu_ld;
+                break;
+            default:
+                g_assert_not_reached();
+            }
+            if (op != INDEX_op_qemu_ld) {
+                    /* the case reconstructs the mop; the stream carries the idx */
+                oi = get_mmuidx(oi);
+            }
+        }
+        tcg_out_op_rrm(s, op, data, addr, oi);
     }
 }
 
@@ -1254,11 +1309,32 @@
 static void tgen_qemu_st(TCGContext *s, TCGType type, TCGReg data,
                          TCGReg addr, MemOpIdx oi)
 {
-    if (oi & ~0xffff) {
+    if (oi & ~0xffff && !tci_mop_specializes(get_memop(oi))) {
         tcg_out_movi(s, TCG_TYPE_I32, TCG_REG_TMP, oi);
         tcg_out_op_rrr(s, INDEX_op_tci_qemu_st_rrr, data, addr, TCG_REG_TMP);
-    } else {
-        tcg_out_op_rrm(s, INDEX_op_qemu_st, data, addr, oi);
+        return;
+    }
+    {
+        MemOp mop = get_memop(oi);
+        TCGOpcode op = INDEX_op_qemu_st;
+
+        if (tci_mop_specializes(mop)) {
+            switch (mop & MO_SIZE) {
+            case MO_8:
+                op = INDEX_op_tci_qemu_st8;
+                break;
+            case MO_16:
+                op = INDEX_op_tci_qemu_st16;
+                break;
+            case MO_32:
+                op = INDEX_op_tci_qemu_st32;
+                break;
+            default:
+                g_assert_not_reached();
+            }
+            oi = get_mmuidx(oi);
+        }
+        tcg_out_op_rrm(s, op, data, addr, oi);
     }
 }
 
diff --git a/include/qemu/wasm-diag.h b/include/qemu/wasm-diag.h
new file mode 100644
--- /dev/null
+++ b/include/qemu/wasm-diag.h
@@ -0,0 +1,23 @@
+/*
+ * wasm diagnostics counters: cold-path memory-subsystem counters filled
+ * by tcg/tci.c + accel/tcg/cputlb.c (interpreter slow-path entries, MMIO
+ * dispatches, TLB fills - ~40k increments/s on a booting pmb887x, cost is
+ * noise) and read from JS via the wasm_memstat() export in ui/wasm.c.
+ * See tools/memstat.mjs.  Hot paths (the inline fast paths) deliberately
+ * carry no counters.
+ */
+#ifndef QEMU_WASM_DIAG_H
+#define QEMU_WASM_DIAG_H
+
+enum {
+    WASM_DIAG_LD_HELPER = 0, /* tci_qemu_ld fell to helper_ldXX_mmu */
+    WASM_DIAG_ST_HELPER,     /* tci_qemu_st fell to helper_stXX_mmu */
+    WASM_DIAG_IO_LD,         /* cputlb MMIO load dispatches */
+    WASM_DIAG_IO_ST,         /* cputlb MMIO store dispatches */
+    WASM_DIAG_TLB_FILL,      /* tlb_fill_align calls */
+    WASM_DIAG_N
+};
+
+extern uint64_t wasm_diag_stat[WASM_DIAG_N];
+
+#endif
diff --git a/ui/wasm.c b/ui/wasm.c
--- a/ui/wasm.c	2026-09-08 19:29:11.780979446 +0000
+++ b/ui/wasm.c	2026-09-08 19:23:32.823983861 +0000
@@ -150,6 +150,14 @@
     return wasm_tb_stats.insns;
 }
 
+/* Diagnostics: memory-subsystem counters (see include/qemu/wasm-diag.h). */
+#include "qemu/wasm-diag.h"
+EMSCRIPTEN_KEEPALIVE
+uint64_t wasm_memstat(int32_t idx)
+{
+    return idx >= 0 && idx < WASM_DIAG_N ? wasm_diag_stat[idx] : 0;
+}
+
 /* Guest virtual clock in ns (diagnostics: boot progress). */
 EMSCRIPTEN_KEEPALIVE
 int64_t wasm_vclock(void)
