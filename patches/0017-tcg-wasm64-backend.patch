+/* a & ~b, a | ~b, ~(a^b), ~(a&b), ~(a|b) */
+static void tgen_andc(TCGContext *s, TCGType t, TCGReg r0, TCGReg r1, TCGReg r2)
+{
+    w64_get(s, r1, t);
+    w64_get(s, r2, t);
+    w64_const(s, t, -1);
+    w64_u8(s, t == TCG_TYPE_I32 ? 0x73 : 0x85);   /* xor */
+    w64_u8(s, t == TCG_TYPE_I32 ? 0x71 : 0x83);   /* and */
+    if (t == TCG_TYPE_I32) {
+        w64_set_i32(s, r0);
+    } else {
+        w64_set_i64(s, r0);
+    }
+}
+static void tgen_andci(TCGContext *s, TCGType t, TCGReg r0, TCGReg r1,
+                       tcg_target_long i2)
+{
+    w64_get(s, r1, t);
+    w64_const(s, t, ~i2);
+    w64_u8(s, t == TCG_TYPE_I32 ? 0x71 : 0x83);   /* and */
+    if (t == TCG_TYPE_I32) {
+        w64_set_i32(s, r0);
+    } else {
+        w64_set_i64(s, r0);
+    }
+}
+static const TCGOutOpBinary outop_andc = {
+    .base.static_constraint = C_O1_I2(r, r, rC),
+    .out_rrr = tgen_andc,
+    .out_rri = tgen_andci,
+};
