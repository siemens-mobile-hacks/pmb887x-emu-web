+    w64_get(s, r1, t);
+    w64_const(s, t, i2);
+    w64_cmp_op(s, t, c);
+    w64_br_to_label(s, l, true);
+}
+
+static const TCGOutOpBrcond outop_brcond = {
+    .base.static_constraint = C_O0_I2(r, rC),
