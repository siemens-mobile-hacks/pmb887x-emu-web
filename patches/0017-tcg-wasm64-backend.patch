+static void tgen_subi(TCGContext *s, TCGType t, TCGReg r0, tcg_target_long i1,
+                      TCGReg r2)
+{
+    /* constant first operand */
+    w64_const(s, t, i1);
+    w64_get(s, r2, t);
+    w64_u8(s, t == TCG_TYPE_I32 ? 0x6b : 0x7d);   /* sub */
+    if (t == TCG_TYPE_I32) {
+        w64_set_i32(s, r0);
+    } else {
+        w64_set_i64(s, r0);
+    }
+}
