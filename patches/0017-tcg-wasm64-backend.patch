+    w64_u8(s, t == TCG_TYPE_I32 ? INV32 : INV64);                          \
+    if (t == TCG_TYPE_I32) {                                               \
+        w64_set_i32(s, r0);                                                \
+    } else {                                                               \
+        w64_set_i64(s, r0);                                                \
