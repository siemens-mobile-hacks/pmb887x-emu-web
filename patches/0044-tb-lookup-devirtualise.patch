accel/tcg: devirtualise the TB-lookup helper on wasm

helper_lookup_tb_ptr runs once per indirect jump: 78 M times per boot,
2.9 M/s, ~10 % of the vCPU (profile, rt=off).  Two of its calls are pure
dispatch in a build with one target and one accelerator:

  - get_tb_cpu_state is reached through cpu->cc->tcg_ops, i.e. a wasm
    call_indirect (table bounds + signature check) around a function the
    linker could call directly;
  - curr_cflags() lives in another translation unit, so the four
    debug-only conditions it tests - none of which can be true in a
    browser build - cost a call instead of folding away.

Both shortcuts are __EMSCRIPTEN__-only; every other build keeps the
generic paths.  This is NOT the rejected per-TB goto_ptr inline cache
(patches/attic/goto-ptr-inline-cache.diff): the key is still computed
once, in the helper.

Measured (dist-jit, S75v40lg1, rt=off): with 0043/0045, interleaved
--runs 4, window 14.2 -> 13.7 s (-4 %), t0.5G 21.8 -> 21.4 (-2 %),
t0.75G 27.1 -> 26.4 (-3 %), t1G -2 %, t1.3G -1 %; the same -2 % on
t0.5G in both orders of two --quick pairs.  helper_lookup_tb_ptr self
time 7.3 % -> 6.5 % of the vCPU.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
--- a/accel/tcg/cpu-exec.c	2026-09-12 17:47:25.096139440 +0000
+++ b/accel/tcg/cpu-exec.c	2026-09-12 16:50:20.522319798 +0000
@@ -381,6 +381,40 @@
         check_for_breakpoints_slow(cpu, pc, cflags);
 }
 
+/*
+ * helper_lookup_tb_ptr runs once per indirect jump - 2.9M/s on this
+ * firmware, 78M per boot - and two of its calls are pure dispatch on a
+ * build with exactly one target and one accelerator:
+ *
+ *  - get_tb_cpu_state is reached through cpu->cc->tcg_ops, i.e. a wasm
+ *    call_indirect (table bounds + signature check) around a function
+ *    the linker could have called directly;
+ *  - curr_cflags() lives in another translation unit, so the four
+ *    debug-only conditions it tests (none of which can be true in a
+ *    browser build: no gdbstub single-step, no -one-insn-per-tb, no
+ *    -d nochain) cost a call instead of folding away.
+ *
+ * Both are wasm-only shortcuts: the generic paths stay for every other
+ * build.
+ */
+#ifdef __EMSCRIPTEN__
+TCGTBCPUState arm_get_tb_cpu_state(CPUState *cs);
+#define W64_GET_TB_CPU_STATE(cpu)  arm_get_tb_cpu_state(cpu)
+
+static inline uint32_t curr_cflags_fast(CPUState *cpu)
+{
+    if (likely(!cpu_single_stepping(cpu) &&
+               !qatomic_read(&one_insn_per_tb) &&
+               !qemu_loglevel_mask(CPU_LOG_TB_NOCHAIN))) {
+        return cpu->tcg_cflags;
+    }
+    return curr_cflags(cpu);
+}
+#else
+#define W64_GET_TB_CPU_STATE(cpu)  ((cpu)->cc->tcg_ops->get_tb_cpu_state(cpu))
+#define curr_cflags_fast(cpu)      curr_cflags(cpu)
+#endif
+
 /**
  * helper_lookup_tb_ptr: quick check for next tb
  * @env: current cpu state
@@ -403,8 +437,8 @@
      */
     cpu->neg.can_do_io = true;
 
-    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
-    s.cflags = curr_cflags(cpu);
+    TCGTBCPUState s = W64_GET_TB_CPU_STATE(cpu);
+    s.cflags = curr_cflags_fast(cpu);
 
     if (check_for_breakpoints(cpu, s.pc, &s.cflags)) {
         cpu_loop_exit(cpu);
