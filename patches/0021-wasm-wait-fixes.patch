From: perf session 2026-09-11
Subject: [PATCH 0021] wasm: untimed cond waits really wait; event notifiers without proxied eventfd writes

Two emscripten-only fixes on the main-loop/vCPU handoff path (both
dists; found while attributing the real-time-paced display-DMA stretch,
playbook § Remaining #2).

1. qemu_cond_wait_impl passed a 0 ms timeout to emscripten_futex_wait,
   which returns at once as "timed out" (max_wait_ns = 0).  Every
   untimed QemuCond wait - the vCPU's halt wait in rr_wait_io_event,
   the io-dump thread, the RCU thread - was therefore a lock/unlock spin
   (measured: 4-10 loop iterations per halt), contending the BQL with
   the main loop (bql_lock in main_loop_wait: 2.5 s of a 10 s stretch
   profile went to __pthread_mutex_timedlock).  Pass INFINITY.
2. event_notifier_set/test_and_clear: an eventfd write()/read() from a
   pthread is a synchronous proxied syscall to the browser main thread
   (~1 ms via emscripten's whole-ms condvar); the fd never became
   pollable on wasm anyway (0009 wakes the main loop through a futex).
   qemu_clock_notify -> event_notifier_set hit this on every icount
   deadline the vCPU handled (~12k times in the display-DMA stretch).
   Keep the notification as an atomic flag.

Measured (idlebench --runs 1, both orders, both dists, quiet host):
  dist-jit  tIdle 66.0 -> 62.6 s / 68.0 -> 58.9 s   (-5 % / -13 %)
  dist      tIdle 76.0 -> 73.0 s / 73.5 -> 64.7 s   (-4 % / -12 %)
  the gain sits from t0.75G on (the stretch: t1.3G -5..-8 % / -13 %).
Rejected on the way (neutral, reverted): dmac/dif/ssc completion timers
on QEMU_CLOCK_VIRTUAL instead of REALTIME (tIdle 66 -> 65 / 70.5 -> 71.9).
Gates: op-suite 1156/1156 x4 (wasm vs native serial identical),
lockstep 250e6 clean, Firefox boots to idle, native code unchanged
(__EMSCRIPTEN__ only).

diff --git a/include/qemu/event_notifier.h b/include/qemu/event_notifier.h
--- a/include/qemu/event_notifier.h	2026-09-11 09:46:16.973434923 +0000
+++ b/include/qemu/event_notifier.h	2026-09-11 09:25:53.086177539 +0000
@@ -25,6 +25,9 @@
     int rfd;
     int wfd;
     bool initialized;
+#ifdef __EMSCRIPTEN__
+    int wasm_pending;       /* set/test_and_clear without the eventfd */
+#endif
 #endif
 };
 
diff --git a/util/event_notifier-posix.c b/util/event_notifier-posix.c
--- a/util/event_notifier-posix.c	2026-09-11 09:46:17.661452466 +0000
+++ b/util/event_notifier-posix.c	2026-09-11 09:25:53.086366285 +0000
@@ -113,6 +113,21 @@
         return -1;
     }
 
+#ifdef __EMSCRIPTEN__
+    /*
+     * wasm: an eventfd/pipe write() from a pthread is a synchronous
+     * proxied syscall to the browser main thread (~1 ms round trip
+     * through emscripten's whole-ms condvar), and the poll() side never
+     * reports the fd readable anyway (util/main-loop.c: the main loop
+     * is woken through a futex by aio_notify/qemu_notify_event).  The
+     * vCPU hit this on every icount deadline (qemu_clock_notify ->
+     * event_notifier_set): ~12k times in the S75 boot's display-DMA
+     * stretch, one ms each.  Keep the notification as an atomic flag.
+     */
+    qatomic_set(&e->wasm_pending, 1);
+    return 0;
+#endif
+
     do {
         ret = write(e->wfd, &value, sizeof(value));
     } while (ret < 0 && errno == EINTR);
@@ -126,6 +141,12 @@
 
 int event_notifier_test_and_clear(EventNotifier *e)
 {
+#ifdef __EMSCRIPTEN__
+    if (!e->initialized) {
+        return 0;
+    }
+    return qatomic_xchg(&e->wasm_pending, 0);
+#endif
     int value;
     ssize_t len;
     char buffer[512];
diff --git a/util/qemu-thread-posix.c b/util/qemu-thread-posix.c
--- a/util/qemu-thread-posix.c	2026-09-11 09:46:17.703851782 +0000
+++ b/util/qemu-thread-posix.c	2026-09-11 09:33:14.619232511 +0000
@@ -250,7 +250,10 @@
 void qemu_cond_wait_impl(QemuCond *cond, QemuMutex *mutex,
                          const char *file, const int line)
 {
-    qemu_cond_wait_common(cond, mutex, 0, file, line);
+    /* INFINITY: emscripten_futex_wait treats 0 ms as "return at once"
+     * (a timed-out wait), which turned every untimed cond wait — the
+     * vCPU's halt wait included — into a lock/unlock spin. */
+    qemu_cond_wait_common(cond, mutex, INFINITY, file, line);
 }
 
 bool qemu_cond_timedwait_impl(QemuCond *cond, QemuMutex *mutex, int ms,
