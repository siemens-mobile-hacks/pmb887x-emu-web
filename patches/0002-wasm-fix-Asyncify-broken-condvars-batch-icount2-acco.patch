 include/qemu/futex.h         | 25 +++++++++
 include/qemu/thread-posix.h  | 11 ++++
 system/icount2.c             | 25 +++++++++
 target/arm/tcg/translate.c   | 11 ++++
 ui/wasm.c                    | 29 +++++++++++
 util/qemu-thread-posix.c     | 99 ++++++++++++++++++++++++++++++++++++
 7 files changed, 208 insertions(+), 2 deletions(-)

