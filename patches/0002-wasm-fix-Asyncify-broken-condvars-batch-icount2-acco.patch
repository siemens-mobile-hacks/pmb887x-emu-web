From 7284c04c689273ab15d9a11559ca624cde79d712 Mon Sep 17 00:00:00 2001
From: sie-mcp web <web@sie-mcp.local>
Date: Sun, 6 Sep 2026 21:56:58 +0000
Subject: [PATCH 2/2] wasm: fix Asyncify-broken condvars + batch icount2
 accounting per TB
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Under Asyncify, emscripten's pthread_cond_signal/broadcast between web
workers is only delivered when the waiter times out, so QemuCond used
for cross-thread wakeup (the pmb887x DSP worker boot-command handshake)
sleeps forever: the L1 task times out and the phone never draws its
splash screen.  The engine-level futex (Atomics.wait/notify) is
Asyncify-safe.

- include/qemu/futex.h: implement the qemu_futex wrappers on
  emscripten_futex_wait/wake; HAVE_FUTEX now defined on emscripten,
  switching QemuEvent/LockCnt to their futex fast paths.
- util/qemu-thread-posix.c + include/qemu/thread-posix.h: futex/seq
  based QemuCond for emscripten (pthread-based everywhere else).

Additionally, TCI helper calls route through libffi, which on wasm is a
JS roundtrip; the per-guest-instruction icount2 cycle helper capped the
interpreter at ~0.6M insns/s.  On emscripten, skip the per-instruction
helper (target/arm/tcg/translate.c) and account executed TBs once in
cpu_tb_exec() (accel/tcg/cpu-exec.c) instead — same icount2 clock, ~50x
cheaper.
---
 accel/tcg/cpu-exec.c         | 25 ++++++++++
 configs/meson/emscripten.txt | 12 ++++-
 include/qemu/futex.h         | 25 ++++++++++
 include/qemu/thread-posix.h  | 11 +++++
 system/icount2.c             | 12 +++++
 target/arm/tcg/translate.c   | 11 +++++
 tcg/tci/tcg-target.c.inc     | 12 +++++
 ui/wasm.c                    | 52 ++++++++++++++++++++
 util/qemu-thread-posix.c     | 95 ++++++++++++++++++++++++++++++++++++
 9 files changed, 253 insertions(+), 2 deletions(-)

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 25721123..96bb067c 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -23,6 +23,7 @@
 #include "qapi/type-helpers.h"
 #include "hw/core/cpu.h"
 #include "accel/tcg/cpu-loop.h"
+#include "system/cpu-timers.h"
 #include "accel/tcg/cpu-ops.h"
 #include "accel/tcg/helper-retaddr.h"
 #include "trace.h"
@@ -438,8 +439,25 @@ cpu_tb_exec(CPUState *cpu, TranslationBlock *itb, int *tb_exit)
         log_cpu_exec(log_pc(cpu, itb), cpu, itb);
     }
 
+#ifdef __EMSCRIPTEN__
+    /*
+     * icount2 cycle accounting is batched per TB on emscripten (the
+     * per-instruction helper would need a libffi/JS roundtrip per guest
+     * instruction under TCI; see target/arm/tcg/translate.c).
+     * Snapshot the count before executing: the TB may be invalidated
+     * (io recompile / self-modifying code) while tcg_qemu_tb_exec runs.
+     */
+    unsigned tb_icount = itb->icount;
+#endif
     qemu_thread_jit_execute();
     ret = tcg_qemu_tb_exec(cpu_env(cpu), tb_ptr);
+#ifdef __EMSCRIPTEN__
+    if (icount2_enabled()) {
+        extern void wasm_tb_account(unsigned insns);
+        wasm_tb_account(tb_icount);
+        icount2_advance(tb_icount);
+    }
+#endif
     cpu->neg.can_do_io = true;
     qemu_plugin_disable_mem_helpers(cpu);
     /*
@@ -890,6 +908,13 @@ static inline void cpu_loop_exec_tb(CPUState *cpu, TranslationBlock *tb,
 {
     trace_exec_tb(tb, pc);
     tb = cpu_tb_exec(cpu, tb, tb_exit);
+#ifdef __EMSCRIPTEN__
+    {
+        extern void wasm_exit_account(int, int, uint32_t);
+        wasm_exit_account(*tb_exit, cpu_loop_exit_requested(cpu),
+                          cpu->interrupt_request);
+    }
+#endif
     if (*tb_exit != TB_EXIT_REQUESTED) {
         *last_tb = tb;
         return;
