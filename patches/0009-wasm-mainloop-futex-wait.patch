From: sie-mcp web <web@sie-mcp.local>
Subject: [PATCH 7/7] wasm: replace the main-loop poll() with a futex wait

emscripten's poll() cannot sleep: __syscall_poll (libsyscall.js)
checks each fd once and returns, ignoring the timeout - the browser
main thread must never block.  The stock os_host_main_loop_wait
therefore never actually waited: it busy-spun through a
synchronously-proxied poll() at ~23k iterations/s during boot
(measured with counters in qemu_poll_ns), each iteration costing a
proxy round-trip plus two BQL handoffs, and the aio eventfd wake
never worked at all (over 950k polls, no fd ever reported ready -
the emscripten pipe poll mask stays 0; the spin itself was the only
wake mechanism).

Replace the wait with a worker-local emscripten futex wait
(ns-precision - the qemu condvar paths truncate to whole
milliseconds on wasm, which measurably slows the firmware's ~100 us
WFI windows), woken by:

  - qemu_notify_event()  (BH kicks / clock notifies)
  - aio_notify()         (BH schedules, aio kicks)

and time out per the main loop's computed deadline.  Because the
vCPU thread executes virtual-clock timers itself (icount2_sync on
deadline crossings; the realtime idle timer covers halts), the main
loop's wait no longer times out on QEMU_CLOCK_VIRTUAL deadlines -
waking ~23k/s for virtual timers the vCPU had already run was most
of the spin.  The fd set is not watched (measured: never ready;
device input arrives via BHs, chardev I/O is proxy-based).

Measured (S75 fullflash, headless Chromium, deterministic
v=2.0->7.0 window; baseline = two runs of the 0001-0008 build):

  window wall time      43.7 / 42.9 s -> 40.1 / 40.4 s   (+8%)
  boot progress @110 s  v=28.9/29.3, ~1.06G insns
                       -> v=34.9/35.5, ~1.31G insns      (+22%)
  full boot trajectory  v=131.4 @240 s vs 111.9 @240 s for 0007

Boot verified: no >>EXIT<<, LCD updating, deep boot past every
historical crash point; native test suite unaffected (all PASS -
the change is __EMSCRIPTEN__-gated).

A millisecond-quantized QemuCond variant of this wait was also
measured: same early-window numbers but +1 ms latency on every WFI
window cost ~20% of the end-to-end gain - keep the raw futex.
---
diff --git a/configs/meson/emscripten.txt b/configs/meson/emscripten.txt
index c7df5ab9af..49f424a7a8 100644
--- a/configs/meson/emscripten.txt
+++ b/configs/meson/emscripten.txt
@@ -18,4 +18,4 @@ cpp_link_args = ['-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILES
 [project options]
 # Workaround for failure to find glib-2.0 when building idef parser,
 # this may be a bug in the cross-build setup used by emscripten:
-hexagon_idef_parser = false
\ No newline at end of file
+hexagon_idef_parser = false
diff --git a/util/async.c b/util/async.c
index 741fcfd6a7..f5b3427943 100644
--- a/util/async.c
+++ b/util/async.c
@@ -464,6 +464,14 @@ LinuxAioState *aio_get_linux_aio(AioContext *ctx)
 
 void aio_notify(AioContext *ctx)
 {
+#ifdef __EMSCRIPTEN__
+    /* wake the condvar-based main-loop wait (util/main-loop.c); the
+     * event_notifier pipe wake does not work on wasm */
+    {
+        extern void qemu_main_loop_wake(void);
+        qemu_main_loop_wake();
+    }
+#endif
     /*
      * Write e.g. ctx->bh_list before writing ctx->notified.  Pairs with
      * smp_mb() in aio_notify_accept().
diff --git a/util/main-loop.c b/util/main-loop.c
index 65e5dbcc94..5d0abf45fe 100644
--- a/util/main-loop.c
+++ b/util/main-loop.c
@@ -23,6 +23,9 @@
  */
 
 #include "qemu/osdep.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten/threading.h>
+#endif
 #include "qapi/error.h"
 #include "qemu/cutils.h"
 #include "qemu/timer.h"
@@ -147,14 +150,60 @@ AioContext *qemu_get_aio_context(void)
     return qemu_aio_context;
 }
 
+#ifdef __EMSCRIPTEN__
+void qemu_main_loop_wake(void);
+#endif
+
 void qemu_notify_event(void)
 {
     if (!qemu_aio_context) {
         return;
     }
     qemu_bh_schedule(qemu_notify_bh);
+#ifdef __EMSCRIPTEN__
+    /*
+     * wasm: the main loop waits on ml_wait_cond (see
+     * os_host_main_loop_wait) - emscripten's poll() cannot sleep and
+     * its pipe/eventfd poll masks never report readiness, so the BH
+     * kick must also wake the waiter directly.
+     */
+    qemu_main_loop_wake();
+#endif
 }
 
+#ifdef __EMSCRIPTEN__
+/*
+ * wasm main-loop wait: emscripten's poll() implementation
+ * (__syscall_poll in libsyscall.js) ignores its timeout - it checks
+ * the fds once and returns; the browser main thread must never block.
+ * The stock os_host_main_loop_wait therefore busy-spins through a
+ * synchronously proxied poll() (~23k iterations/s during boot, each
+ * with a proxy round-trip and two BQL handoffs), and the aio eventfd
+ * wake never actually worked (the emscripten pipe poll mask stays 0 -
+ * the spin itself was the only wake mechanism).
+ *
+ * Replace the poll with a worker-local timed wait on a condvar that
+ * qemu_notify_event()/aio_notify() signal.  The fd set is never
+ * watched - measured over 950k polls during boot, no fd ever became
+ * ready (all returns r==0); device input arrives via BHs (wasm.c
+ * input ring) and chardev I/O is proxy-based, not poll-driven.
+ */
+/*
+ * The wait itself is a raw emscripten futex (not QemuCond): the
+ * condvar paths truncate to whole milliseconds on wasm, but the
+ * firmware's WFI windows are as short as ~100 us and are served by
+ * this wait - a 1 ms floor measurably slows the whole boot.
+ */
+static int32_t ml_futex_wake;   /* 0 = sleeping, 1 = wake requested */
+
+void qemu_main_loop_wake(void)
+{
+    if (qatomic_xchg(&ml_futex_wake, 1) == 0) {
+        emscripten_futex_wake(&ml_futex_wake, INT_MAX);
+    }
+}
+#endif
+
 static GArray *gpollfds;
 
 int qemu_init_main_loop(Error **errp)
@@ -307,7 +356,19 @@ static int os_host_main_loop_wait(int64_t timeout)
     bql_unlock();
     replay_mutex_unlock();
 
+#ifdef __EMSCRIPTEN__
+    /* see qemu_main_loop_wake() above: poll() cannot sleep on wasm */
+    qatomic_set(&ml_futex_wake, 0);
+    if (timeout < 0) {
+        emscripten_futex_wait(&ml_futex_wake, 0, INFINITY);
+    } else if (timeout > 0) {
+        emscripten_futex_wait(&ml_futex_wake, 0,
+                              (double)timeout / 1000000.0);
+    }
+    ret = 0;
+#else
     ret = qemu_poll_ns((GPollFD *)gpollfds->data, gpollfds->len, timeout);
+#endif
 
     replay_mutex_lock();
     bql_lock();
@@ -587,9 +648,28 @@ void main_loop_wait(int nonblocking)
         timeout_ns = (uint64_t)mlpoll.timeout * (int64_t)(SCALE_MS);
     }
 
+#ifdef __EMSCRIPTEN__
+    /*
+     * wasm icount2: virtual-clock deadlines belong to the vCPU thread
+     * (icount2_sync) / the realtime idle timer - the main loop would
+     * wake for every one of them (~24k/s during boot) for nothing.
+     * Time the poll on the remaining clocks only.
+     */
+    {
+        int type;
+        for (type = 0; type < QEMU_CLOCK_MAX; type++) {
+            if (type == QEMU_CLOCK_VIRTUAL) {
+                continue;
+            }
+            timeout_ns = qemu_soonest_timeout(
+                timeout_ns, timerlist_deadline_ns(main_loop_tlg.tl[type]));
+        }
+    }
+#else
     timeout_ns = qemu_soonest_timeout(timeout_ns,
                                       timerlistgroup_deadline_ns(
                                           &main_loop_tlg));
+#endif
 
     ret = os_host_main_loop_wait(timeout_ns);
     mlpoll.state = ret < 0 ? MAIN_LOOP_POLL_ERR : MAIN_LOOP_POLL_OK;
