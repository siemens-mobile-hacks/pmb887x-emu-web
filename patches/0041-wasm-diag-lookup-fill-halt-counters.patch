From: perf session 2026-09-12
Subject: [PATCH 0041] wasm diag: TB-lookup, TLB-fill/flush and halt counters

Cold-path counters (wasm_diag_stat, read by tools/memstat.mjs and
tools/stopwatch.mjs): tb_lookup calls / jump-cache hits / qht hits,
jump-cache flushes, count-limited translations, every TLB table clear
and page-in-large-page flush, fill classification (fetch / probe /
same-page / tiny-page / large-page / eviction, sum of mmu_idx), the
mmu_idx-0 table size and use, and vCPU idle entries.  They decided
this session's targets: 78 M lookups per boot at 92 % jump-cache hits
(the cost is the helper, not misses); 83k fills/s with zero flushes
(-> 0040); halts/s = 0 while the stopwatch runs (the guest is
compute-bound, not mis-paced).  Hot paths carry nothing.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
--- a/accel/tcg/cpu-exec.c	2026-09-12 08:50:51.810328836 +0000
+++ b/accel/tcg/cpu-exec.c	2026-09-12 08:50:50.609227255 +0000
@@ -19,6 +19,7 @@
 
 #include "qemu/osdep.h"
 #include "qemu/qemu-print.h"
+#include "qemu/wasm-diag.h"
 #include "qapi/error.h"
 #include "qapi/type-helpers.h"
 #include "hw/core/cpu.h"
@@ -244,12 +245,18 @@
     hash = tb_jmp_cache_hash_func(s.pc);
     jc = cpu->tb_jmp_cache;
 
+#ifdef __EMSCRIPTEN__
+    wasm_diag_stat[WASM_DIAG_LOOKUP]++;
+#endif
     tb = qatomic_read(&jc->array[hash].tb);
     if (likely(tb &&
                jc->array[hash].pc == s.pc &&
                tb->cs_base == s.cs_base &&
                tb->flags == s.flags &&
                tb_cflags(tb) == s.cflags)) {
+#ifdef __EMSCRIPTEN__
+        wasm_diag_stat[WASM_DIAG_LOOKUP_JC]++;
+#endif
         goto hit;
     }
 
@@ -257,6 +264,9 @@
     if (tb == NULL) {
         return NULL;
     }
+#ifdef __EMSCRIPTEN__
+    wasm_diag_stat[WASM_DIAG_LOOKUP_QHT]++;
+#endif
 
     jc->array[hash].pc = s.pc;
     qatomic_set(&jc->array[hash].tb, tb);
