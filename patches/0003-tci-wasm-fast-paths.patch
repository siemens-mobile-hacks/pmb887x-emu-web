+        return true;
+    case 0x054b: /* (i64,i64,i64) -> u32 */
+        stack[0] = ((uint32_t (*)(uint64_t, uint64_t, uint64_t))func)(stack[0], stack[1], stack[2]);
+        return true;
+    case 0x02b3: /* (i32,i32,i32) -> u64 */
