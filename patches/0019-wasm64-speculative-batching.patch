+    for (i = 0; i < n_smalls; i++) {
+        const struct w64_bsrc *src = &smalls[i]->src;
+        for (m = 0; m < src->n_member; m++) {
+            uint32_t *desc = (uint32_t *)(uintptr_t)src->member[m].tcptr;
+            if (desc[W64_DESC_BATCH / 4] == (W64_BATCH_TAG | src->id)) {
