+struct w64_gp_layout {
+    uint32_t off_pc;                    /* u32 field */
+    uint32_t off_flags, off_flags2;     /* hflags: u32, u64 */
+    uint32_t off_thumb, off_condexec;   /* u8, u32 */
+    uint32_t off_veclen, off_vecstride; /* i32, i32 */
+    uint32_t off_fpexc;                 /* u32; bit 30 = VFP enabled */
+    uint32_t ss_active_mask;            /* in flags: refuse the cache */
+    uint32_t thumb_shift, condexec_shift, veclen_shift, vecstride_shift,
+             vfpen_shift;               /* deposits into cs_base */
+};
+bool w64_target_gp_layout(struct w64_gp_layout *l);
