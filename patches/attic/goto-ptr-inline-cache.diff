+/* ------------------------------------------------------------------ */
+/* goto_ptr inline cache                                               */
+/*                                                                    */
+/* lookup_and_goto_ptr = helper_lookup_tb_ptr(env) + goto_ptr.  The   */
+/* helper computes the lookup key from the CPU state (target's        */
+/* get_tb_cpu_state), probes the jump cache, falls back to the qht —   */
+/* an import call + ~150 ns per indirect jump, ~6-8 % of the vCPU.    */
+/* Each TB keeps a one-entry cache (tb->w64_gp: pc, flags, cs_base,   */
+/* desc, tb) of what its lookup last resolved to; the emitted code     */
+/* computes the same key inline (layout from the target,              */
+/* w64_target_gp_layout) and tail-calls the cached descriptor when the */
+/* key matches and the target is still valid (not CF_INVALID, still   */
+/* instantiated, no lockstep brake).  Misses take the helper and       */
+/* refill the entry.  Keys with SS_ACTIVE (gdb singlestep) never hit.  */
+/* W64_NOGPCACHE=1 disables it (A/B).                                  */
+/* ------------------------------------------------------------------ */
+
+extern TranslationBlock *w64_last_tb;   /* accel/tcg/cpu-exec.c */
+
+static struct w64_gp_layout GPL;
+static int gpl_state = -1;
+
+static bool w64_gp_on(void)
+{
+    if (gpl_state < 0) {
+        gpl_state = getenv("W64_NOGPCACHE") == NULL &&
+                    w64_target_gp_layout(&GPL);
+    }
+    return gpl_state == 1;
+}
+
+/* env-relative load of an unsigned field as i64 */
+static void w64_gp_ld(TCGContext *s, uint8_t opc, unsigned align, uint32_t off)
+{
+    w64_local_get(s, W64_P_ENV);
+    w64_u8(s, opc);
+    w64_memarg(s, align, off);
+}
+
+static void w64_gp_slot_load(TCGContext *s, uintptr_t cache, unsigned slot)
+{
+    w64_const_i64(s, (int64_t)cache);
+    w64_u8(s, 0x29);                        /* i64.load */
+    w64_memarg(s, 3, 8 * slot);
+}
+
+/* key -> $scr0 (pc), $scr32 (flags), $scr1 (cs_base); hit -> tail call */
+static void w64_out_gp_probe(TCGContext *s)
+{
+    uintptr_t cache = (uintptr_t)s->gen_tb + offsetof(TranslationBlock, w64_gp);
+
+    w64_gp_ld(s, 0x35, 2, GPL.off_pc);      /* i64.load32_u regs[15] */
+    w64_local_set(s, W64_L_SCR0);
+    w64_gp_ld(s, 0x28, 2, GPL.off_flags);   /* i32.load hflags.flags */
+    w64_local_set(s, W64_L_SCR32);
+
+    w64_gp_ld(s, 0x35, 2, GPL.off_flags2);  /* (u32)hflags.flags2 */
+    w64_gp_ld(s, 0x31, 0, GPL.off_thumb);   /* i64.load8_u thumb */
+    w64_const_i64(s, GPL.thumb_shift);
+    w64_u8(s, 0x86);                        /* i64.shl */
+    w64_u8(s, 0x84);                        /* i64.or */
+    w64_gp_ld(s, 0x35, 2, GPL.off_condexec);
+    w64_const_i64(s, 0xff);
+    w64_u8(s, 0x83);                        /* i64.and */
+    w64_const_i64(s, GPL.condexec_shift);
+    w64_u8(s, 0x86);
+    w64_u8(s, 0x84);
+    w64_gp_ld(s, 0x35, 2, GPL.off_veclen);
+    w64_const_i64(s, 7);
+    w64_u8(s, 0x83);
+    w64_const_i64(s, GPL.veclen_shift);
+    w64_u8(s, 0x86);
+    w64_u8(s, 0x84);
+    w64_gp_ld(s, 0x35, 2, GPL.off_vecstride);
+    w64_const_i64(s, 3);
+    w64_u8(s, 0x83);
+    w64_const_i64(s, GPL.vecstride_shift);
+    w64_u8(s, 0x86);
+    w64_u8(s, 0x84);
+    w64_gp_ld(s, 0x35, 2, GPL.off_fpexc);
+    w64_const_i64(s, 30);
+    w64_u8(s, 0x88);                        /* i64.shr_u */
+    w64_const_i64(s, 1);
+    w64_u8(s, 0x83);
+    w64_const_i64(s, GPL.vfpen_shift);
+    w64_u8(s, 0x86);
+    w64_u8(s, 0x84);
+    w64_local_set(s, W64_L_SCR1);
+
+    tcg_debug_assert(W.n_blk < W64_MAX_BLK);
+    w64_u8(s, 0x02);                        /* block void */
+    w64_u8(s, 0x40);
+    W.blk[W.n_blk].kind = W64_BLK_IF;
+    W.blk[W.n_blk].label = -1;
+    W.n_blk++;
+
+    /* every br_if 0 below is a miss: fall through to the helper call */
+    w64_local_get(s, W64_L_SCR32);
+    w64_const_i32(s, (int32_t)GPL.ss_active_mask);
+    w64_u8(s, 0x71);                        /* i32.and */
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_local_get(s, W64_L_SCR0);
+    w64_gp_slot_load(s, cache, 0);
+    w64_u8(s, 0x52);                        /* i64.ne */
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_local_get(s, W64_L_SCR32);
+    w64_u8(s, 0xad);                        /* i64.extend_i32_u */
+    w64_gp_slot_load(s, cache, 1);
+    w64_u8(s, 0x52);
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_local_get(s, W64_L_SCR1);
+    w64_gp_slot_load(s, cache, 2);
+    w64_u8(s, 0x52);
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_gp_slot_load(s, cache, 3);          /* desc */
+    w64_local_set(s, W64_L_SCR2);
+    w64_local_get(s, W64_L_SCR2);
+    w64_u8(s, 0x50);                        /* i64.eqz */
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_gp_slot_load(s, cache, 4);          /* tb */
+    w64_u8(s, 0x28);                        /* i32.load tb->cflags */
+    w64_memarg(s, 2, offsetof(TranslationBlock, cflags));
+    w64_const_i32(s, CF_INVALID);
+    w64_u8(s, 0x71);
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_const_i64(s, (int64_t)(uintptr_t)&w64_chain_stop);
+    w64_u8(s, 0x28);
+    w64_memarg(s, 2, 0);
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_local_get(s, W64_L_SCR2);
+    w64_u8(s, 0x28);                        /* i32.load fidx */
+    w64_memarg(s, 2, W64_DESC_FIDX);
+    w64_u8(s, 0x45);                        /* i32.eqz */
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_local_get(s, W64_L_SCR2);
+    w64_u8(s, 0x28);                        /* i32.load tidx */
+    w64_memarg(s, 2, W64_DESC_TIDX);
+    w64_local_set(s, W64_L_SCR32);
+    w64_local_get(s, W64_P_ENV);
+    w64_local_get(s, W64_P_SP);
+    w64_local_get(s, W64_P_TP);
+    w64_local_get(s, W64_L_SCR32);
+    w64_u8(s, 0x13);                        /* return_call_indirect */
+    w64_uleb(s, 0);
+    w64_uleb(s, 0);
+
+    w64_blk_pop(s);                         /* end */
+}
+
+/* after the helper returned into $R0: refill the entry on a hit */
+static void w64_out_gp_fill(TCGContext *s)
+{
+    uintptr_t cache = (uintptr_t)s->gen_tb + offsetof(TranslationBlock, w64_gp);
+
+    tcg_debug_assert(W.n_blk < W64_MAX_BLK);
+    w64_u8(s, 0x02);
+    w64_u8(s, 0x40);
+    W.blk[W.n_blk].kind = W64_BLK_IF;
+    W.blk[W.n_blk].label = -1;
+    W.n_blk++;
+
+    w64_local_get(s, W64_L64(TCG_REG_R0));
+    w64_u8(s, 0x50);                        /* i64.eqz: miss (epilogue) */
+    w64_u8(s, 0x0d); w64_uleb(s, 0);
+
+    w64_const_i64(s, (int64_t)cache);
+    w64_local_get(s, W64_L_SCR0);
+    w64_u8(s, 0x37); w64_memarg(s, 3, 0);
+    w64_const_i64(s, (int64_t)cache);
+    w64_local_get(s, W64_L_SCR32);
+    w64_u8(s, 0xad);
+    w64_u8(s, 0x37); w64_memarg(s, 3, 8);
+    w64_const_i64(s, (int64_t)cache);
+    w64_local_get(s, W64_L_SCR1);
+    w64_u8(s, 0x37); w64_memarg(s, 3, 16);
+    w64_const_i64(s, (int64_t)cache);
+    w64_local_get(s, W64_L64(TCG_REG_R0));
+    w64_u8(s, 0x37); w64_memarg(s, 3, 24);
+    w64_const_i64(s, (int64_t)cache);
+    w64_const_i64(s, (int64_t)(uintptr_t)&w64_last_tb);
+    w64_u8(s, 0x29); w64_memarg(s, 3, 0);
+    w64_u8(s, 0x37); w64_memarg(s, 3, 32);
+
+    w64_blk_pop(s);
+}
+
