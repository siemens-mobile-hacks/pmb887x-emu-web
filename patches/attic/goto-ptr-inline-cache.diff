+/*
+ * wasm64 goto_ptr inline cache: describe arm_get_tb_cpu_state() for the
+ * A32 (non-M) case — pc = regs[15]; flags = hflags.flags (+PSTATE__SS
+ * only when SS_ACTIVE, which the backend refuses); cs_base = hflags.flags2
+ * with VECLEN/VECSTRIDE/VFPEN(FPEXC.EN)/THUMB/CONDEXEC deposited.
+ */
+bool w64_target_gp_layout(struct w64_gp_layout *l)
+{
+    CPUARMState *env = cpu_env(first_cpu);
+
+    if (arm_feature(env, ARM_FEATURE_M) ||
+        arm_feature(env, ARM_FEATURE_AARCH64)) {
+        return false;
+    }
+    l->off_pc = offsetof(CPUARMState, regs[15]);
+    l->off_flags = offsetof(CPUARMState, hflags.flags);
+    l->off_flags2 = offsetof(CPUARMState, hflags.flags2);
+    l->off_thumb = offsetof(CPUARMState, thumb);
+    l->off_condexec = offsetof(CPUARMState, condexec_bits);
+    l->off_veclen = offsetof(CPUARMState, vfp.vec_len);
+    l->off_vecstride = offsetof(CPUARMState, vfp.vec_stride);
+    l->off_fpexc = offsetof(CPUARMState, vfp.xregs[ARM_VFP_FPEXC]);
+    l->ss_active_mask = R_TBFLAG_ANY_SS_ACTIVE_MASK;
+    l->thumb_shift = R_TBFLAG_AM32_THUMB_SHIFT;
+    l->condexec_shift = R_TBFLAG_AM32_CONDEXEC_SHIFT;
+    l->veclen_shift = R_TBFLAG_A32_VECLEN_SHIFT;
+    l->vecstride_shift = R_TBFLAG_A32_VECSTRIDE_SHIFT;
+    l->vfpen_shift = R_TBFLAG_A32_VFPEN_SHIFT;
+    QEMU_BUILD_BUG_ON(sizeof(env->thumb) != 1);
+    QEMU_BUILD_BUG_ON(sizeof(env->hflags.flags) != 4);
+    QEMU_BUILD_BUG_ON(sizeof(env->hflags.flags2) != 8);
+    QEMU_BUILD_BUG_ON(sizeof(env->vfp.vec_len) != 4);
+    QEMU_BUILD_BUG_ON(sizeof(env->condexec_bits) != 4);
+    return true;
+}
