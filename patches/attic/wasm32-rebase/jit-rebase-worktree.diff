+static void fill_uint32_leb128(uintptr_t bi, uint32_t v) {
+    uint8_t *b = (uint8_t *)bi;
+    uint32_t low7 = 0x7f;
+    // assuems higher bit already written as placeholders
+    do {
+        *b |= v & low7;
+        v >>= 7;
+        b++;
+    } while (v != 0);
