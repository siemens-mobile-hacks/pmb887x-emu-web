From: perf session 2026-09-11
Subject: [PATCH 0030] wasm64: speculation skips nodes whose successors were all found translated

w64_speculate walks breadth-first through already-translated TBs so that
their still-missing successors join the batch.  A neighbourhood that is
completely translated was re-walked on every lookup miss inside it: two
non-faulting probes + a qht lookup per edge, for nothing.  Host-time
counters over a boot: 35k speculation calls, 5.6 s total of which 4.8 s
was the nested translation of new successors — 0.87 s of pure walk.  A
per-TB flag (w64_explored, reset with the TB) marks a node whose
expansion completed with every successor present (or just translated);
explored nodes are not expanded again.  The walk overhead dropped to
0.29 s per boot; translations per boot unchanged within noise.

Measured (idlebench --quick, one pair, stack 0023-0030 vs the session
base): t0.5G 33.4->30.5 (-9 %), t1.3G 48.4->40.3 (-17 %); the 0029
stack measured 40.5 — this patch is worth ~0.5 s by its counter.
Gates: op-suite wasm64 1156/1156, lockstep 250e6 clean.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
--- a/accel/tcg/cpu-exec.c	2026-09-11 12:34:25.083106047 +0000
+++ b/accel/tcg/cpu-exec.c	2026-09-11 12:31:15.505637117 +0000
@@ -688,6 +688,18 @@
         vaddr succ[ARRAY_SIZE(tb->w64_succ) + 1];
         unsigned nsucc = tb->w64_nsucc;
         unsigned i;
+        bool complete = true;
+
+        /*
+         * A node whose successors were all found translated by an
+         * earlier walk has nothing to offer: the walk through already-
+         * translated TBs re-probed and re-looked-up the same edges on
+         * every miss in the neighbourhood (~2 % of the boot's vCPU time
+         * in probes + qht lookups for nothing).
+         */
+        if (tb->w64_explored) {
+            continue;
+        }
 
         memcpy(succ, tb->w64_succ, nsucc * sizeof(succ[0]));
         /*
@@ -709,8 +721,13 @@
             }
         }
 
-        for (i = 0; i < nsucc && made < (unsigned)budget && qt < qmax; i++) {
+        for (i = 0; i < nsucc; i++) {
             TCGTBCPUState t = s;
+
+            if (made >= (unsigned)budget || qt >= qmax) {
+                complete = false;
+                break;
+            }
             TranslationBlock *ex;
             vaddr next_page;
             unsigned k;
@@ -763,6 +780,9 @@
             }
             qt++;
         }
+        if (complete) {
+            tb->w64_explored = 1;
+        }
     }
     return false;
 }
