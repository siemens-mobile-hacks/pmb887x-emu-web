From: sie-mcp web <web@sie-mcp.local
Subject: [PATCH 6/7] tci: immediate-form ALU/setcond ops (no tci_movi
 materialization for small constants)

TCI materialized every constant into a register with tci_movi before
any op that consumes it - there are no immediate operand forms, unlike
every native backend (x86 folds constants via tcg_target_const_match +
out_rri, which the qemu-11 outop tables already provide).  On this
workload tci_movi was 18.9% of all interpreted ops, mostly feeding
`add` (guest ldr/str base+offset addressing - 7.4% of all ops) and
`setcond`/`brcond` comparisons against 0 (7.0% + 5.9%).

Wire TCI into the existing immediate-operand machinery:

- new TCI-only ops (appended to the tci extra-opc list, before the
  wasm-only tci_tbhdr of patch 0007, keeping numbering compatible):
    tci_add_ri, tci_and_ri, tci_or_ri, tci_xor_ri, tci_andc_ri
      (r0, r1, sext16 imm) and
    tci_setcond32_ri (r0, r1, cond, sext12 imm).
- constraint letters 'S' (fits sext16) / 'B' (fits sext12), a
  tcg_target_const_match that for TCG_TYPE_I32 accepts any constant
  whose low bits match (TCI i32 register upper bits are undefined;
  consumers truncate - see the i32 ops in tcg/tci.c), and outop
  wiring (.out_rri/.out_ri/.out_i hooks) for add/and/or/xor/andc,
  setcond (i32 only, C_Dynamic) and brcond (i32 only, C_Dynamic:
  setcond32_ri into TMP + brcond, mirroring tgen_brcond).
- the middle-end picks the forms automatically: tcg_gen_addi/andi/xori/
  ori/brcondi compare each constant against the constraint and skip
  the movi; constants that do not fit fall back to the stock path.

The interpreter decodes the immediate into a local int32_t (an earlier
revision passed &t1, a tcg_target_ulong, to an int32_t* out-parameter:
a compile error under gcc-14+ pointer-type checking and stale upper
bits for the i64 forms); the disassembler cases likewise decode into
their own int32_t and no longer hijack the stock 3-reg ALU group's
tci_args_rrr decoder.

Measured (S75 fullflash, headless Chromium, WATCH samples; the same
deterministic v=2.0 -> 7.0 virtual-time window as the patch 0007
baseline run, page-start skew eliminated by v-milestone interpolation):

  window wall time      46.7 s -> 43.7 s / 42.9 s   (+6.8-9.0%)
  opcode histogram      tci_movi   18.94% -> 12.75%
                        add         7.37% ->  1.04% (+ tci_add_ri 6.85%)
                        tci_setcond32 7.03% -> 2.97%
                          (+ tci_setcond32_ri 4.20%)
  boot                  no >>EXIT<<; reaches v=29 in 110 s where the
                        0007 build reaches v=23.4

This is generic TCI work (not emscripten-gated); native TCI builds
benefit identically.  Native TCG backends are untouched.

Conflicts with the 0005 wasm32 DRAFT (tcg/tci emitters).
---
Note: a store-immediate extension (tci_st32_ri/st8_ri + implementing
the tcg_out_sti constant-spill hook, two-word encoding) was measured
on top of this and REJECTED: deterministic-window wall time regressed
from 42.9-43.7 s to 50.6-50.7 s (two runs each), so it is not part of
this patch.  Do not re-add it without re-measuring.
diff --git a/tcg/tci.c b/tcg/tci.c
index 16737166bb..70b8258486 100644
--- a/tcg/tci.c
+++ b/tcg/tci.c
@@ -126,6 +126,22 @@ static void tci_args_rrs(uint32_t insn, TCGReg *r0, TCGReg *r1, int32_t *i2)
     *i2 = sextract32(insn, 16, 16);
 }
 
+static void tci_args_rri(uint32_t insn, TCGReg *r0, TCGReg *r1, int32_t *i2)
+{
+    *r0 = extract32(insn, 8, 4);
+    *r1 = extract32(insn, 12, 4);
+    *i2 = sextract32(insn, 16, 16);
+}
+
+static void tci_args_rrci(uint32_t insn, TCGReg *r0, TCGReg *r1,
+                          TCGCond *c2, int32_t *i3)
+{
+    *r0 = extract32(insn, 8, 4);
+    *r1 = extract32(insn, 12, 4);
+    *c2 = extract32(insn, 16, 4);
+    *i3 = sextract32(insn, 20, 12);
+}
+
 static void tci_args_rrbb(uint32_t insn, TCGReg *r0, TCGReg *r1,
                           uint8_t *i2, uint8_t *i3)
 {
@@ -1203,6 +1219,49 @@ uintptr_t QEMU_DISABLE_CFI tcg_qemu_tb_exec(CPUArchState *env,
             break;
 #endif
 
+        case INDEX_op_tci_add_ri:
+        {
+            int32_t imm;
+            tci_args_rri(insn, &r0, &r1, &imm);
+            regs[r0] = regs[r1] + imm;
+            break;
+        }
+        case INDEX_op_tci_and_ri:
+        {
+            int32_t imm;
+            tci_args_rri(insn, &r0, &r1, &imm);
+            regs[r0] = regs[r1] & imm;
+            break;
+        }
+        case INDEX_op_tci_or_ri:
+        {
+            int32_t imm;
+            tci_args_rri(insn, &r0, &r1, &imm);
+            regs[r0] = regs[r1] | imm;
+            break;
+        }
+        case INDEX_op_tci_xor_ri:
+        {
+            int32_t imm;
+            tci_args_rri(insn, &r0, &r1, &imm);
+            regs[r0] = regs[r1] ^ imm;
+            break;
+        }
+        case INDEX_op_tci_andc_ri:
+        {
+            int32_t imm;
+            tci_args_rri(insn, &r0, &r1, &imm);
+            regs[r0] = regs[r1] & ~imm;
+            break;
+        }
+        case INDEX_op_tci_setcond32_ri:
+        {
+            int32_t imm;
+            tci_args_rrci(insn, &r0, &r1, &condition, &imm);
+            regs[r0] = tci_compare32(regs[r1], imm, condition);
+            break;
+        }
+
         case INDEX_op_br:
             tci_args_l(insn, tb_ptr, &ptr);
             tb_ptr = ptr;
@@ -1768,6 +1827,28 @@ int print_insn_tci(bfd_vma addr, disassemble_info *info)
                            op_name, str_r(r0), str_r(r1), str_r(r2));
         break;
 
+    case INDEX_op_tci_add_ri:
+    case INDEX_op_tci_and_ri:
+    case INDEX_op_tci_or_ri:
+    case INDEX_op_tci_xor_ri:
+    case INDEX_op_tci_andc_ri:
+    {
+        int32_t imm;
+        tci_args_rri(insn, &r0, &r1, &imm);
+        info->fprintf_func(info->stream, "%-12s  %s, %s, %d",
+                           op_name, str_r(r0), str_r(r1), (int)imm);
+        break;
+    }
+
+    case INDEX_op_tci_setcond32_ri:
+    {
+        int32_t imm;
+        tci_args_rrci(insn, &r0, &r1, &c, &imm);
+        info->fprintf_func(info->stream, "%-12s  %s, %s, %s, %d",
+                           op_name, str_r(r0), str_r(r1), str_c(c), (int)imm);
+        break;
+    }
+
     case INDEX_op_tci_ctz32:
     case INDEX_op_tci_clz32:
     case INDEX_op_tci_divs32:
