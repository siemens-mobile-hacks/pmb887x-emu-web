From: perf session 2026-09-11
Subject: [PATCH 0033] pmb887x: seed the RTC counter in the layout the firmware expects (per board)

The pinned rev's "fix RTC date/time encoding" (3e497d7ae7) seeds RTC CNT
as a packed calendar (sec/min/hour/yday in the 10/6/6/10-bit fields, REL
= 964/4/40/(1024-365) so each field wraps like 60/60/24/365).  That is
what the LG firmware reads (KE800 shows the right date/time with it),
but the Siemens firmware treats CNT as one linear 32-bit Unix-seconds
counter and adds its own time-zone setting: the packed value decodes to
"Wed 02 May 2091" (0xE4391BEA = 2091-05-02 12:39 UTC, shown as 15:39 in
the phone's UTC+3) and, because a minute wrap is 0x3FF -> 0x7C4 (+965),
the displayed clock jumps +16 min at every minute boundary (measured
15:39 -> 15:55 across one wrap, then 1x within the minute; ~22x on
average, ~300x native without the 0032 cap where the idle virtual clock
also warps).  Reproduced identically on the pristine native build, so it
was never a wasm or warp-patch regression.

Add a "cnt-format" property to pmb887x-rtc: "calendar" (the packed
layout) or "unix" (linear seconds since the epoch, REL = 0 so the fields
carry into each other).  The board picks it from the optional board
config key board.rtc.format, defaulting by vendor: LG -> calendar,
everything else -> unix.  Both honour -rtc base=/clock= through
qemu_get_timedate() (lockstep's fixed base stays deterministic).

Verified (screendumps 20-50 s apart, host 17:2x UTC): native S75 "Пт 11
Сен 21:22", C81 "11.09.2026 20:22", KE800 "17:20 11/9" (unchanged); wasm
dist-jit 21:23 -> 21:24 over 60 s, dist 21:26 -> 21:27 over 40 s.  EL71
shows its set-time wizard with either layout (pre-existing, unrelated).

diff --git a/hw/arm/pmb887x/board.c b/hw/arm/pmb887x/board.c
--- a/hw/arm/pmb887x/board.c	2026-09-11 17:22:33.741544866 +0000
+++ b/hw/arm/pmb887x/board.c	2026-09-11 17:19:52.364665389 +0000
@@ -300,6 +300,11 @@
 	// RTC
 	DeviceState *rtc = pmb887x_new_cpu_module("RTC");
 	object_property_set_link(OBJECT(rtc), "cgu", OBJECT(cgu), &error_fatal);
+	// How the firmware reads RTC CNT at power-on: LG decodes packed
+	// calendar fields, Siemens a linear Unix-seconds counter (see rtc.c).
+	const char *rtc_default_format = strcmp(pmb887x_board()->vendor, "LG") == 0 ? "calendar" : "unix";
+	qdev_prop_set_string(rtc, "cnt-format",
+		toml_table_get_string(pmb887x_board()->config, "board.rtc.format", rtc_default_format, false));
 	sysbus_realize_and_unref(SYS_BUS_DEVICE(rtc), &error_fatal);
 
 	// GPTU0
diff --git a/hw/arm/pmb887x/rtc.c b/hw/arm/pmb887x/rtc.c
--- a/hw/arm/pmb887x/rtc.c	2026-09-11 17:22:33.805546781 +0000
+++ b/hw/arm/pmb887x/rtc.c	2026-09-11 17:20:03.688011516 +0000
@@ -13,6 +13,7 @@
 #include "qapi/error.h"
 #include "qemu/timer.h"
 #include "qemu/main-loop.h"
+#include "qemu/cutils.h"
 #include "hw/core/qdev-properties.h"
 
 #include "hw/arm/pmb887x/gen/cpu_regs.h"
@@ -37,7 +38,8 @@
 	SysBusDevice parent_obj;
 	MemoryRegion mmio;
 	uint32_t revision;
-	
+	char *cnt_format;
+
 	pmb887x_clc_reg_t clc;
 	pmb887x_src_reg_t src;
 	pmb887x_cgu_t *cgu;
@@ -314,16 +316,36 @@
 		(((day_rel + yday) & 0x3FF) << 22);
 }
 
+/*
+ * Power-on seed of CNT/REL, in the layout the firmware expects (the
+ * "cnt-format" property, chosen per board):
+ *
+ *   calendar  sec/min/hour/yday packed into the 10/6/6/10-bit fields with
+ *             REL set so each field wraps like a 60/60/24/365 calendar
+ *             (LG firmware reads the fields directly);
+ *   unix      one linear 32-bit seconds counter since the Unix epoch with
+ *             REL = 0 so the fields carry into each other (Siemens firmware
+ *             adds its own time-zone setting on top).  A calendar seed
+ *             here decodes to the year 2091 and jumps +16 min at every
+ *             minute wrap (0x3FF -> 0x7C4 is +965).
+ *
+ * Both honour -rtc base=/clock= through qemu_get_timedate().
+ */
 static void rtc_init_datetime(pmb887x_rtc_t *p) {
 	struct tm tm;
 	qemu_get_timedate(&tm, 0);
 
-	uint32_t year = 1900 + tm.tm_year;
-	bool leap = !(year % 4) && ((year % 100) || !(year % 400));
-	uint32_t day_rel = 0x400 - (leap ? 366 : 365);
-
-	p->rel = rtc_pack_cnt(day_rel, 0, 0, 0, 0);
-	p->cnt = rtc_pack_cnt(day_rel, tm.tm_yday, tm.tm_hour, tm.tm_min, tm.tm_sec);
+	if (p->cnt_format && !strcmp(p->cnt_format, "calendar")) {
+		uint32_t year = 1900 + tm.tm_year;
+		bool leap = !(year % 4) && ((year % 100) || !(year % 400));
+		uint32_t day_rel = 0x400 - (leap ? 366 : 365);
+
+		p->rel = rtc_pack_cnt(day_rel, 0, 0, 0, 0);
+		p->cnt = rtc_pack_cnt(day_rel, tm.tm_yday, tm.tm_hour, tm.tm_min, tm.tm_sec);
+	} else {
+		p->rel = 0;
+		p->cnt = mktimegm(&tm);
+	}
 }
 
 static void rtc_reset(DeviceState *dev) {
@@ -354,7 +376,11 @@
 		hw_error("CGU not found...");
 	if (!p->irq)
 		hw_error("pmb887x-rtc: irq not set");
-	
+	if (p->cnt_format && strcmp(p->cnt_format, "unix") && strcmp(p->cnt_format, "calendar")) {
+		error_setg(errp, "pmb887x-rtc: unknown cnt-format '%s' (unix|calendar)", p->cnt_format);
+		return;
+	}
+
 	pmb887x_clc_init(&p->clc);
 	pmb887x_src_init(&p->src, p->irq);
 	p->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rtc_ptimer_reset, p);
@@ -368,6 +394,7 @@
 
 static const Property rtc_properties[] = {
 	DEFINE_PROP_UINT32("revision", pmb887x_rtc_t, revision, 0),
+	DEFINE_PROP_STRING("cnt-format", pmb887x_rtc_t, cnt_format),
 	DEFINE_PROP_LINK("cgu", pmb887x_rtc_t, cgu, "pmb887x-cgu", pmb887x_cgu_t *),
 };
 
