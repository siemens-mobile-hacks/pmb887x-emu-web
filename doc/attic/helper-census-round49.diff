+
+/* round-49 helper census (temporary) */
+struct w64_hc { const void *fn; const char *name; uint64_t n, n0; };
+static struct w64_hc w64_hc_tab[1024];
+static unsigned w64_hc_n;
+
+uint64_t *w64_hc_ctr(const void *fn, const char *name)
+{
+    unsigned i;
+    for (i = 0; i < w64_hc_n; i++) {
+        if (w64_hc_tab[i].fn == fn && w64_hc_tab[i].name == name) {
+            return &w64_hc_tab[i].n;
+        }
+    }
+    if (w64_hc_n == ARRAY_SIZE(w64_hc_tab)) {
+        return &w64_hc_tab[0].n0;
+    }
+    w64_hc_tab[w64_hc_n].fn = fn;
+    w64_hc_tab[w64_hc_n].name = name;
+    return &w64_hc_tab[w64_hc_n++].n;
+}
+
+static int w64_hc_cmp(const void *a, const void *b)
+{
+    const struct w64_hc *x = a, *y = b;
+    uint64_t dx = x->n - x->n0, dy = y->n - y->n0;
+    return dx < dy ? 1 : dx > dy ? -1 : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void wasm_hc_mark(int32_t phase)
+{
+    unsigned i;
+    if (phase == 0) {
+        for (i = 0; i < w64_hc_n; i++) {
+            w64_hc_tab[i].n0 = w64_hc_tab[i].n;
+        }
+        return;
+    }
+    {
+        static struct w64_hc cp[1024];
+        unsigned n = w64_hc_n;
+        memcpy(cp, w64_hc_tab, n * sizeof(cp[0]));
+        qsort(cp, n, sizeof(cp[0]), w64_hc_cmp);
+        for (i = 0; i < n && i < 60; i++) {
+            fprintf(stderr, "HCENSUS %s %llu\n", cp[i].name,
+                    (unsigned long long)(cp[i].n - cp[i].n0));
+        }
+    }
+}
