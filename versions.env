# Pinning for the qemu-pmb887x wasm build.
#
# The web build is intentionally decoupled from the MCP servers in this repo:
# it clones upstream sources at these revisions into web/build/ (never
# committed) and applies the small patches from web/patches/.
#
# qemu 43d084b2 (2026-08-02 "pmb887x: add native TCG DSP emulation") is the
# revision the pmb887x-emu-mcp container was built from; bsp 9277046 is the
# matching board-config revision (the S75 board gained an unimplemented RF
# peripheral in d915b5c, so anything newer breaks siemens-s75).
export QEMU_PMB887X_REPO="https://github.com/Azq2/qemu-pmb887x"
export QEMU_PMB887X_REV="2735ce4e"

export PMB887X_BSP_REPO="https://github.com/Azq2/pmb887x-dev"
export PMB887X_BSP_REV="9277046"

# Toolchain versions (mirror qemu's tests/docker/dockerfiles/emsdk-wasm64-cross.docker)
export EMSDK_VERSION="4.0.10"
export ZLIB_VERSION="1.3.2"
export PIXMAN_VERSION="0.44.2"
export LIBFFI_VERSION="v3.5.2"
export GLIB_VERSION="2.84.0"
