# Pinning for the qemu-pmb887x wasm build.
#
# The web build is intentionally decoupled from the MCP servers in this repo:
# it clones upstream sources at these revisions into web/build/ (never
# committed) and applies the small patches from web/patches/.
#
# Revisions = the submodule pins of the latest pmb887x-emu master
# (https://github.com/siemens-mobile-hacks/pmb887x-emu @ d0f101b):
#   qemu 1f7fc803bf (2026-09-07 "pmb887x: add RFSSC wiring and PMB6272 stub")
#   bsp  49b0130    (2026-09-07 "unit: add DMA DIFv2 blit tests")
#
# Known upstream bug worked around by patches/bsp/*.patch: the BSP board
# configs define an RF peripheral of type "hd155153np" that the emulator's
# device table does not define (only the pmb6272 RF stub exists) —
# qemu aborts with 'hardware error: Unknown device: hd155153np' at board
# init. The patch re-points the two affected includes at the pmb6272 stub.
export QEMU_PMB887X_REPO="https://github.com/Azq2/qemu-pmb887x"
export QEMU_PMB887X_REV="1f7fc803bf71ef64638c71a10e697f7970465f0a"

export PMB887X_BSP_REPO="https://github.com/Azq2/pmb887x-dev"
export PMB887X_BSP_REV="49b013004b5880ebd8764c3dc1ec0211d7dc8c1c"

# Toolchain versions (mirror qemu's tests/docker/dockerfiles/emsdk-wasm64-cross.docker)
export EMSDK_VERSION="4.0.10"
export ZLIB_VERSION="1.3.2"
export PIXMAN_VERSION="0.44.2"
export LIBFFI_VERSION="v3.5.2"
export GLIB_VERSION="2.84.0"
