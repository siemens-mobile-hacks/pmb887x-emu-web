# Pinning for the qemu-pmb887x wasm build.
#
# The qemu source is the root-level qemu/ submodule (Azq2/qemu-pmb887x,
# local branch wasm-browser-port = origin/wasm-patches): the whole
# wasm/TCI/perf series committed on top of qemu-pmb887x master
# (8b9d485bc2), plus the AFE fix cherry-picked from alula's dsp-stuff
# branch and the per-board RTC-seed commit. (The former patches/*.patch
# files were removed on 2026-09-12; the commits are the series.)
# The pmb887x-emu meta-repo is checked out alongside (its own qemu
# submodule pin is the same revision) but is not built from.
#
# Why not plain master: master alone aborts every Siemens fullflash
# during L1 GSM frame handling (">>EXIT<< FILE: l1bbcsg / CepName:
# H_GSMFR" at ~25-30 s — the L1<->DSP handshake starves); the "hacky AFE
# (LLE+HLE)" commit from dsp-stuff fixes s75/el71/c81.
#   qemu debfa3d6f5 (2026-09-12 "pmb887x: seed the RTC counter in the
#                    layout the firmware expects" — the tip of the series)
#   bsp  e6e73d1    (2026-09-11 "board: LG boards read the RTC counter as
#                    packed calendar fields" — the [rtc] format = "calendar"
#                    the LG firmware needs, the companion of qemu's RTC
#                    cnt-format commit)
#
# Known upstream bug worked around by bsp-patches/*.patch: the BSP board
# configs define an RF peripheral of type "hd155153np" that the emulator's
# device table does not define (only the pmb6272 RF stub exists) —
# qemu aborts with 'hardware error: Unknown device: hd155153np' at board
# init. The patch re-points the two affected includes at the pmb6272 stub.
export QEMU_PMB887X_REPO="https://github.com/Azq2/qemu-pmb887x"
export QEMU_PMB887X_REV="debfa3d6f56859e1f60bcae7af125433f90f061b"
export QEMU_PMB887X_BRANCH="wasm-browser-port"

export PMB887X_BSP_REPO="https://github.com/Azq2/pmb887x-dev"
export PMB887X_BSP_REV="e6e73d147b3b3c6c61d88935a1c61ba9ffe7b70a"

# Toolchain versions (mirror qemu's tests/docker/dockerfiles/emsdk-wasm64-cross.docker)
export EMSDK_VERSION="4.0.10"
export ZLIB_VERSION="1.3.2"
export PIXMAN_VERSION="0.44.2"
export LIBFFI_VERSION="v3.5.2"
export GLIB_VERSION="2.84.0"
