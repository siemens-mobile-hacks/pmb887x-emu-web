# Pins for the qemu-pmb887x builds, sourced by scripts/build-deps.sh,
# build-qemu.sh, build-release.sh and sync-bsp.sh. What each pin moved to
# and why is in doc/version-pins.md.

# qemu/ submodule source: Azq2/qemu-pmb887x with the wasm/TCI/perf series and
# the dsp-lle merge (real DSP firmware; plain master aborts in l1bbcsg).
export QEMU_PMB887X_REPO="https://github.com/Azq2/qemu-pmb887x"
# the wasm-browser-port tip build-qemu.sh and build-release.sh check out
export QEMU_PMB887X_REV="d992a03bf8"
export QEMU_PMB887X_BRANCH="wasm-browser-port"

# board configs (boards.tar); must match the generated tables in that qemu
export PMB887X_BSP_REPO="https://github.com/Azq2/pmb887x-dev"
export PMB887X_BSP_REV="191612cab6ccc37fe91acdee3302e5b537dc6e2d"

# Toolchain versions (mirror qemu's tests/docker/dockerfiles/emsdk-wasm64-cross.docker)
export EMSDK_VERSION="4.0.10"
export ZLIB_VERSION="1.3.2"
# zlib-1.3.2.tar.xz; the sha256 GitHub's release lists for the asset
export ZLIB_SHA256="d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3"
export PIXMAN_VERSION="0.44.2"
export LIBFFI_VERSION="v3.5.2"
export GLIB_VERSION="2.84.0"
# glib-2.84.0.tar.xz; from download.gnome.org's glib-2.84.0.sha256sum
export GLIB_SHA256="f8823600cb85425e2815cfad82ea20fdaa538482ab74e7293d58b3f64a5aff6a"
