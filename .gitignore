# build outputs
/site/dist/
/site/dist-jit/
/build/

# static deploy bundle (scripts/bundle-dist.sh → served by deploy/nginx/)
/dist/
/deploy/nginx/.env

# IDE cruft
/.idea/

# stray screenshots at repo root
/*.png

# toolchains/dependencies
node_modules

# self-signed dev cert for LAN https
.serve-cert/

# test artifacts (headless-browser screenshots)
/tools/*.png

# local test fullflash config
/tools/testflash.local.json

# fullflash / firmware dumps
*.bin

# session daemon artifacts
tools/.session*
tools/.serve.log

# test suite build/run artifacts
tests/insncount.so
tests/lockstep.so
tests/results/

# tcg-isa build artifacts (binaries covered by *.bin; keep the elf/objects out too)
tests/tcg-isa/*.o
tests/tcg-isa/*.elf
# A/B snapshot dists (baselines saved before candidate deploys — see doc/
# wasm-tcg-backend-progress.md; /site/dist/ and /site/dist-jit/ above are
# the live ones)
/site/dist-*/

# fullflash dumps + sidecars (firmware images, not for git)
/fullflashes/

# tcgbench build artifacts (make -C tests/tcgbench)
/tests/tcgbench/*.o
/tests/tcgbench/*.elf
/tests/tcgbench/*.bin

# playwright browser download (tools/chrome) — a local binary, never committed
tools/chrome/

# sjlj microbenchmark build output (regenerate: tools/sjljbench.mjs)
/site/sjlj/

# j2mebench local host-tuning state, not shared
/tests/.j2me-*

# python bytecode caches (tools/perf/ analysis scripts)
__pycache__/

# perf sweep run output ($S / PERF_LOGS — see tools/perf/README.md).  Raw
# evidence the docs cite is committed under tools/perf/round35/ instead.
/tools/perf/logs/
